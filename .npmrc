# Pin to the public npm registry so CI hosts (GitHub Actions, Render) don't
# inherit a private/internal registry from the developer's ~/.npmrc.
registry=https://registry.npmjs.org/

# Quieter, leaner install for memory-constrained CI hosts. The Render free
# tier (512 MB) was killing `npm ci` partway through with
# "Exit handler never called!" — turning off audit/fund/progress and using
# prefer-offline removes background work and network round-trips.
audit=false
fund=false
loglevel=error
progress=false
prefer-offline=true
